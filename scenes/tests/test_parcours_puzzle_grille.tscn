[node name="Zone3" type="Label" parent="Reperes"]
offset_left = 3300.0
offset_top = 520.0
offset_right = 5200.0
offset_bottom = 700.0
theme_override_font_sizes/font_size = 24
text = "3 — PLATEFORME PORTABLE + DASH\nE pour prendre • pose-la dans le premier trou • monte dessus • dash vers la rive droite."
horizontal_alignment = 1

[node name="Zone4" type="Label" parent="Reperes"]
offset_left = 5400.0
