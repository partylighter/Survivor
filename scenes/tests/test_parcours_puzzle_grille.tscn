[node name="Zone6" type="Label" parent="Reperes"]
offset_left = 8050.0
offset_top = 1950.0
offset_right = 11750.0
offset_bottom = 2180.0
theme_override_font_sizes/font_size = 22
text = "6 — ENNEMIS PUZZLE\nPATROUILLE = bouge à chaque pas • BELIER = tous les 2 pas, pousse + dégâts\nTEMPS REEL = timer indépendant • DOS SEUL = immobile, dégâts acceptés uniquement par l'arrière (flèche jaune = face)"
horizontal_alignment = 1

