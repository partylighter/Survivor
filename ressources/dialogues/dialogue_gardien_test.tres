[gd_resource type="Resource" script_class="DonneeDialogue" format=3 uid="uid://bpymmw26fbu2n"]

[ext_resource type="Script" uid="uid://d1g7pmiardoax" path="res://scripts/dialogues/ChoixDialogue.gd" id="1_choix"]
[ext_resource type="Script" uid="uid://tkc3vv4vuwkp" path="res://scripts/dialogues/DonneeDialogue.gd" id="2_dialogue"]

[sub_resource type="Resource" id="Choix_reponse"]
script = ExtResource("1_choix")
texte_bouton = "Réponse : Qui es-tu ?"
texte_resultat = "Je suis le gardien de cette scène de test."

[sub_resource type="Resource" id="Choix_action"]
script = ExtResource("1_choix")
texte_bouton = "Action : Recevoir une potion"
type_choix = 1
texte_resultat = "Potion reçue : l'action a bien été demandée."
identifiant_action = &"donner_potion"

[sub_resource type="Resource" id="Choix_fermer"]
script = ExtResource("1_choix")
texte_bouton = "Quitter la conversation"
type_choix = 2

[resource]
script = ExtResource("2_dialogue")
texte_initial = "Bonjour voyageur. Que veux-tu tester ?"
choix = Array[ExtResource("1_choix")]([SubResource("Choix_reponse"), SubResource("Choix_action"), SubResource("Choix_fermer")])
